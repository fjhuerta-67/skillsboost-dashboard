# ==========================================================
# 1. Google Skills for Organizations API v2
# ==========================================================
SKILLS_API_BASE_URL=https://www.skills.google/api/v2
SKILLS_ACCESS_KEY=
SKILLS_SECRET_KEY=
SKILLS_ORGANIZATION_SLUG=
SKILLS_CONTRACTED_LICENSES=500

# ==========================================================
# 2. Motor de Inteligencia (Gemini API o Vertex AI con ADC)
# ==========================================================
# Opción A: Clave de Google AI Studio (Secret Manager en Cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opción B (Recomendada en Cloud Run): Vertex AI autenticado con Service Account (sin clave estática)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1

# ==========================================================
# 3. Arquitectura Multi-Backend: Local | GCS | BigQuery
# ==========================================================
# APP_ENV: "local" (por defecto) o "cloud" (auto-detectado en Cloud Run)
APP_ENV=local
# STORAGE_BACKEND: "local" (.data/store.json), "gcs" (Cloud Storage) o "bigquery" (Data Warehouse)
STORAGE_BACKEND=local

# Configuración General Google Cloud
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_REGION=us-central1
SERVICE_NAME=skillsboost-dashboard

# Configuración BigQuery Data Warehouse (cuando STORAGE_BACKEND=bigquery)
BQ_PROJECT_ID=tu-proyecto-gcp
BQ_DATASET_ID=skillsboost_analytics
BQ_LOCATION=us-central1
BQ_CACHE_TTL_MS=300000

# Configuración Google Cloud Storage (cuando STORAGE_BACKEND=gcs o espejo de respaldo)
GCS_DATA_BUCKET=tu-proyecto-gcp-skillsboost-data
GCS_DATA_OBJECT=store.json.gz

# Huso horario corporativo para cálculo de ventanas laborales en Learning Pulse (ej. 0, -5, -6)
CORPORATE_UTC_OFFSET=0

# Configuración de Sincronización Programada (Cloud Run Job)
# SYNC_LOOKBACK_DAYS=0 sincroniza historial completo; >0 sincroniza ventana incremental (ej. 30 días)
SYNC_LOOKBACK_DAYS=0
CLOUD_RUN_SERVICE_URL=
CRON_REFRESH_TOKEN=

# Seguridad adicional en Cloud Run:
# - LOCK_SETTINGS_IN_CLOUD=true bloquea la edición de claves API desde la interfaz web
# - DASHBOARD_ACCESS_PASSWORD activa protección HTTP Basic Auth si despliegas con ALLOW_UNAUTHENTICATED=true
LOCK_SETTINGS_IN_CLOUD=false
DASHBOARD_ACCESS_PASSWORD=
ALLOW_UNAUTHENTICATED=false
