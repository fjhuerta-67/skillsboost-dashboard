{
  "name": "skillsboost-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=local STORAGE_BACKEND=local tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "start:local": "NODE_ENV=production APP_ENV=local STORAGE_BACKEND=local tsx server.ts",
    "start:cloud": "NODE_ENV=production APP_ENV=cloud STORAGE_BACKEND=gcs tsx server.ts",
    "start:bq": "NODE_ENV=production APP_ENV=cloud STORAGE_BACKEND=bigquery tsx server.ts",
    "sync:job": "tsx scripts/run-sync-job.ts",
    "data:verify": "tsx scripts/cloud-sync-cli.ts verify",
    "data:push": "tsx scripts/cloud-sync-cli.ts push",
    "data:pull": "tsx scripts/cloud-sync-cli.ts pull",
    "data:init-bq": "tsx scripts/cloud-sync-cli.ts init-bq",
    "data:push-bq": "tsx scripts/cloud-sync-cli.ts push-bq",
    "data:pull-bq": "tsx scripts/cloud-sync-cli.ts pull-bq",
    "deploy:cloud": "bash scripts/deploy-cloud-run.sh",
    "deploy:wizard": "tsx scripts/deploy-interactive.ts",
    "security:audit": "tsx scripts/verify-sanitized.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
